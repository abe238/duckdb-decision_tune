# name: test/sql/parity_decisions.test
# description: decision_choose matches onnxruntime + tokenizers in Python (test/data/parity/decisions.csv)
# group: [sql]

require decision_tune

require-env DECISION_TUNE_MODEL_PATH

statement ok
SET decision_tune_model_path = '{DECISION_TUNE_MODEL_PATH}';

statement ok
CREATE TABLE cases AS
SELECT case_id::INTEGER AS case_id, coalesce(state, '') AS state, question, string_split(options, '␞') AS options,
       probabilities::DOUBLE[] AS expected
FROM read_csv('test/data/parity/decisions.csv', header = true, all_varchar = true, quote = '"', escape = '"');

query I
SELECT count(*) FROM cases;
----
11

statement ok
CREATE TABLE results AS
SELECT case_id, expected, options, decision_choose(state, question, options) AS d FROM cases;

# Same probabilities (a different ONNX Runtime build may round differently)
query I
SELECT case_id FROM results
WHERE len(expected) <> cardinality(d.probabilities)
   OR list_max(list_transform(range(1, len(expected) + 1), lambda i: abs(expected[i] - d.probabilities[options[i]]))) > 1e-4
ORDER BY case_id;
----

# The choice is the most likely option, and the confidence its probability
query I
SELECT bool_and(d.choice = options[list_position(expected, list_max(expected))] AND abs(d.confidence - list_max(expected)) < 1e-4)
FROM results;
----
true

# README example: Shipping at 71.2%, over Tech support at 20.9 and Billing at 7.9
query IIII
SELECT d.choice, round(d.probabilities['Shipping: delivery, lost or damaged packages'] * 100, 1),
       round(d.probabilities['Tech support: bugs, crashes, login problems'] * 100, 1),
       round(d.probabilities['Billing: charges, refunds, invoices'] * 100, 1)
FROM results WHERE case_id = 0;
----
Shipping: delivery, lost or damaged packages	71.2	20.9	7.9

# decision_yes_no is the probability of the first of the options ['yes', 'no']
query I
SELECT bool_and(abs(decision_yes_no(state, question) - expected[1]) < 1e-4) FROM cases WHERE options = ['yes', 'no'];
----
true
