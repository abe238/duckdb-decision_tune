# name: test/sql/model_store.test
# description: a cached file whose content does not match the manifest is rejected and removed
# group: [sql]

require decision_tune

statement ok
SET decision_tune_cache_dir = '{TEST_DIR}';

# same name and size as the real file, wrong content (csv adds the trailing newline)
statement ok
COPY (SELECT repeat('x', (SELECT file_bytes - 1 FROM decision_tune_models() WHERE file_name = 'tokenizer.json')::BIGINT))
TO '{TEST_DIR}/tokenizer.json' (FORMAT csv, HEADER false, QUOTE '');

query I
SELECT cached FROM decision_tune_models() WHERE file_name = 'tokenizer.json';
----
true

# (a column, so the optimizer does not fold the call into a constant first)
statement error
SELECT decision_tune_tokenize(s) FROM (SELECT 'hello' || i AS s FROM range(1) r(i));
----
IO Error: decision_tune: checksum mismatch for tokenizer.json

query I
SELECT cached FROM decision_tune_models() WHERE file_name = 'tokenizer.json';
----
false
